# Dependencies
node_modules/

# Production builds
dist/
out/
*.msi

# Rust / Tauri build artifacts
src-tauri/target/
src-tauri/compat-helper/target/
src-tauri/resources/*.exe
src-tauri/resources/*.so
src-tauri/gen/schemas/linux-schema.json
__pycache__/

# OS Files
.DS_Store
Thumbs.db

# Editor / IDE / tooling
.vs/
.vscode/
.idea/
.claude/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# Local Config
config.json
.env

# Secrets / signing material — never commit private keys or certificates
*.pfx
*.pem
*.key
*.p12

# Dev scratch / generated artifacts
build_log.txt
diff_*.txt

# Local screenshot/preview harness (generated, never shipped)
src/__preview*
