{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rec EOS Launcher",
  "version": "4.0.0",
  "identifier": "com.radium.launcher",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Rec EOS Launcher",
        "label": "main",
        "width": 1000,
        "height": 650,
        "minWidth": 900,
        "minHeight": 550,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: radiumimg: http://radiumimg.localhost; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "shell": {
      "open": "^(https://[\\w.-]+(/[^\\s]*)?|steam://|steam://install/[0-9]+|windowsdefender://appbrowser)$"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "abod124-sudo",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "template": "./installer.nsi",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "headerImage": "icons/nsis-header.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "wix": {
        "bannerPath": "icons/wix-banner.bmp",
        "dialogImagePath": "icons/wix-dialog.bmp"
      }
    },
    "resources": [
      "steam_api64.dll"
    ]
  }
}